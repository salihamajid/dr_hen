// Dr. Hen — Prisma schema
// Postgres in production (Render, DATABASE_URL pointing at a free Neon
// instance — Render's own managed Postgres has no free tier). Local dev
// currently shares that same Neon database (see .env). The schema deliberately
// never used Postgres-only features (native scalar arrays — Json columns
// instead), so provider is never a reason to touch this file again.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection (-pooler host) can't hold the advisory lock
  // `prisma migrate deploy` needs — migrations must go over a direct connection.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum FarmerStatus {
  HEALTHY
  AT_RISK
  UNDER_TREATMENT
  ESCALATED
}

enum TreatmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum DiseaseCode {
  ND // Newcastle Disease / Ranikhet
  IB // Infectious Bronchitis
  CRD // Chronic Respiratory Disease
  COCCIDIOSIS
  AI_H9 // Avian Influenza H9
  OTHER
  UNKNOWN
}

enum MessageChannel {
  WHATSAPP
  IN_APP
}

enum UserRole {
  ADMIN
  FARMER
}

enum Language {
  EN
  UR
}

enum AlertSeverity {
  INFO
  ALERT
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum VentilationLevel {
  POOR
  AVERAGE
  GOOD
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageContentType {
  TEXT
  IMAGE
  VOICE
  VIDEO
  TEMPLATE
}

enum SenderType {
  FARMER
  AI_AGENT
  ADMIN
  FIELD_VET
}

model Farmer {
  id             String   @id @default(cuid())
  name           String
  location       String
  whatsappNumber String   @unique
  flockSize      Int
  numberOfSheds  Int
  flockAgeWeeks  Int
  breed          String
  status         FarmerStatus @default(HEALTHY)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  flocks         Flock[]
  dailyReports   DailyReport[]
  treatments     Treatment[]
  vaccinations   Vaccination[]
  messages       Message[]
  vetEscalations VetEscalation[]
  user           User?
  alerts         Alert[]
}

model Flock {
  id        String   @id @default(cuid())
  farmerId  String
  farmer    Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name      String
  breed     String
  sizeCount Int
  ageWeeks  Int
  startDate DateTime
  active    Boolean  @default(true)

  dailyReports DailyReport[]
  treatments   Treatment[]
  vaccinations Vaccination[]
  alerts       Alert[]

  @@index([farmerId])
}

model DailyReport {
  id             String   @id @default(cuid())
  farmerId       String
  farmer         Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  flockId        String?
  flock          Flock?   @relation(fields: [flockId], references: [id])
  date           DateTime @default(now())
  fcr            Float?
  avgWeightGrams Float?
  mortalityCount Int      @default(0)
  notes          String?

  // Farmer-portal fields. All optional so existing rows and the admin path keep
  // working. One row per (farmer, flock, day): the Daily Entry and Attributes
  // screens both upsert this same row, so the fields they share (feed, water,
  // temperature) can never hold two contradictory values for one day.
  feedKg         Float?
  waterLiters    Float?
  temperatureC   Float?
  humidityPct    Float?
  lightHours     Float?
  ventilation    VentilationLevel?
  // Farmer-REPORTED history, never a recommendation. Must never be fed to
  // buildFarmerReply or shown as approved — that would route around the
  // DISEASE_PROTOCOL medicine allowlist.
  medicineGiven  String?
  // Optional on purpose: a required @updatedAt is NOT NULL with no default,
  // which fails on a table that already has rows.
  updatedAt      DateTime? @updatedAt

  @@index([farmerId, date])
  // Postgres treats NULLs as distinct, so legacy rows with flockId = null are
  // NOT deduplicated (intentional — the admin path keeps working). Uniqueness
  // is guaranteed for the farmer-portal path, where flockId is always set.
  @@unique([farmerId, flockId, date], name: "daily_report_farmer_flock_date")
}

// The 12 client-approved medicines. Seeded from src/lib/ai/diseaseProtocol.ts —
// that file, not this table, is the source of truth the AI allowlist reads from.
model Medicine {
  id           String  @id @default(cuid())
  name         String  @unique
  manufacturer String // "ST Vet Pharma" | "Supers Diana"
  category     String? // antibiotic / vitamin / oral solution / etc.
}

// One row per disease, mirroring DISEASE_PROTOCOL in src/lib/ai/diseaseProtocol.ts.
model MedicineProtocol {
  id               String      @id @default(cuid())
  diseaseCode      DiseaseCode @unique
  diseaseName      String
  primaryMedicines Json // string[]
  supportMedicines Json? // string[] | null
  notes            String?
  isAntibiotic     Boolean     @default(false)
}

model Treatment {
  id              String           @id @default(cuid())
  farmerId        String
  farmer          Farmer           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  flockId         String?
  flock           Flock?           @relation(fields: [flockId], references: [id])
  diseaseCode     DiseaseCode
  medicinesGiven  Json // string[], validated against Medicine at write time
  status          TreatmentStatus  @default(SCHEDULED)
  startedAt       DateTime?
  completedAt     DateTime?
  nextActionAt    DateTime?
  nextActionNote  String?
  sourceMessageId String?          @unique
  sourceMessage   Message?         @relation("TreatmentSource", fields: [sourceMessageId], references: [id])
  createdAt       DateTime         @default(now())

  @@index([farmerId, status])
}

model Vaccination {
  id               String           @id @default(cuid())
  farmerId         String
  farmer           Farmer           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  flockId          String?
  flock            Flock?           @relation(fields: [flockId], references: [id])
  vaccineName      String
  scheduledDate    DateTime
  administeredDate DateTime?
  status           TreatmentStatus  @default(SCHEDULED)
  notes            String?

  @@index([farmerId, status])
}

model Message {
  id                String             @id @default(cuid())
  farmerId          String
  farmer            Farmer             @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  channel           MessageChannel     @default(WHATSAPP)
  direction         MessageDirection
  senderType        SenderType
  contentType       MessageContentType
  textContent       String?
  mediaUrl          String?
  detectedLanguage  String?
  aiDiagnosis       Json?
  whatsappMessageId String?            @unique
  rawWebhookPayload Json?
  createdAt         DateTime           @default(now())

  treatmentSourced  Treatment?         @relation("TreatmentSource")

  @@index([farmerId, createdAt])
}

model FieldVet {
  id             String  @id @default(cuid())
  name           String
  region         String // "Rawalpindi" | "Kotli Sattian"
  phoneNumber    String
  whatsappNumber String?
  active         Boolean @default(true)

  vetEscalations VetEscalation[]
}

model VetEscalation {
  id                String   @id @default(cuid())
  farmerId          String
  farmer            Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  fieldVetId        String?
  fieldVet          FieldVet? @relation(fields: [fieldVetId], references: [id])
  triggerMessageId  String?
  status            String   @default("PENDING") // PENDING | CONTACTED | RESOLVED
  createdAt         DateTime @default(now())
}

model User {
  id           String    @id @default(cuid())
  // ADMIN logs in by email; FARMER by phone. Each is null for the other role,
  // which is what makes cross-role login structurally impossible.
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  role         UserRole
  // null = the farmer hasn't picked a language yet -> show the chooser.
  language     Language?
  // Bump to invalidate every outstanding session cookie for this user.
  tokenVersion Int       @default(0)
  farmerId     String?   @unique
  farmer       Farmer?   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Alert {
  id         String        @id @default(cuid())
  farmerId   String
  farmer     Farmer        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  flockId    String?
  flock      Flock?        @relation(fields: [flockId], references: [id])
  code       String
  severity   AlertSeverity
  status     AlertStatus   @default(OPEN)
  // Wording is stored in both languages at the moment the alert fires, so it
  // stays frozen — an alert is a health record, not a live-translated view.
  titleEn    String
  titleUr    String
  bodyEn     String
  bodyUr     String
  metrics    Json?
  // "<farmerId>:<flockId|->:<code>:<YYYY-MM-DD>" — the whole idempotency
  // mechanism: re-evaluating the same day can never create a second alert.
  dedupeKey  String        @unique
  createdAt  DateTime      @default(now())
  readAt     DateTime?
  resolvedAt DateTime?

  @@index([farmerId, status, createdAt])
}
